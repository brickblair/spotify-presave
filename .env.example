# Copy to .env and fill in.

# Existing app
PORT=3000
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_STATE=
REDIRECTURI=

# Email -> Notion agent integration
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the default model
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Create an integration at https://www.notion.so/profile/integrations
# then share your target database with it.
NOTION_TOKEN=
# The ID of the database that will receive emails (the 32-char hex from its URL).
NOTION_DATABASE_ID=
